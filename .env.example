# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# Never put real values in this file or anywhere in the repository.

# Supabase (Project Settings -> API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# AI keys (server only)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Any long random text; protects the daily clean-up job
CRON_SECRET=...

# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.8-flash
